# Скопируйте в .env (рядом с guardian.py) и заполните.
# Токен бота: @BotFather → /newbot
TG_TOKEN=
# chat_id: запустите serve, напишите боту /start — он пришлёт номер
TG_CHAT_ID=
# id пользователей, которым можно жать кнопки (через запятую). Для группы — обязательно
TG_ADMINS=

# Сколько секунд ждать решения человека (30–900); потом — отказ. 0 — без ограничений: действие ждёт, пока вы не ответите
GUARDIAN_TIMEOUT=300
# Бэкап файлов, когда действие меняет файлы и ушло к человеку: auto (сразу) | ask (кнопкой) | off
GUARDIAN_BACKUP=auto
# AI-судья: off | risky (только подозрительное) | all
GUARDIAN_JUDGE=risky
# Ключ для AI-судьи (нужен pip install anthropic)
ANTHROPIC_API_KEY=
